---
import '../styles/global.css';
import type { solarTheme } from '../lib/theme.ts';

interface Props {
  theme?: ReturnType<typeof solarTheme>;
  title: string;
  description?: string;
  canonical?: string;
}
const { theme, title, description = 'Sunrise, sunset and twilight times anywhere in the world, charted over the year.', canonical } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={theme?.mode} style={theme && Object.entries(theme.variables).map(([name, value]) => `${name}:${value}`).join(';')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.url)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content={theme?.mode ?? 'light'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="wordmark"><span class="sun-glyph" aria-hidden="true"></span>Equilux</a>
      <nav><a href="/about">About</a></nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Places from <a href="https://www.geonames.org/">GeoNames</a> (CC BY 4.0). Maps ©
        <a href="https://openfreemap.org/">OpenFreeMap</a>, <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>.
        Equilux grew out of Sunlightr, which has been telling people when the sun comes up since 2007.
      </p>
    </footer>
  </body>
</html>
